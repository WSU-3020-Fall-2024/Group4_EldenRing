class Alexander extends Boss {
    public Alexander() {
        super("Alexander", 60, 10, 15);
    }

    public int getRandomDamage() {
        return new Random().nextInt(super.maxDamage - super.minDamage + 1) + super.minDamage; // using super
    }

    public void enterSecondPhase() {
        if (!super.secondPhaseTriggered) {
            super.secondPhaseTriggered = true;
            System.out.println("Alexander heats up! His body glows red with magma and his attacks grow fiercer.");
            this.minDamage += 8;
            this.maxDamage += 12;
        }
    }
}
